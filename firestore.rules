rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuth()  { return request.auth != null; }
    function isOwner(uid) { return request.auth.uid == uid; }
    function isAdmin() {
      return isAuth() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Un partido ya "arrancó" (las apuestas están cerradas) → sus pronósticos son públicos
    function matchStarted(matchId) {
      let m = get(/databases/$(database)/documents/matches/$(matchId)).data;
      return m.status == 'IN_PLAY' || m.status == 'PAUSED' || m.status == 'FINISHED';
    }

    // ¿Estamos ANTES del cierre de apuestas? (30 min antes del inicio, verificado por el servidor)
    // Imposible de saltear por API directa: usa la hora del servidor y el kickoff guardado.
    function beforeCutoff(matchId) {
      let m = get(/databases/$(database)/documents/matches/$(matchId)).data;
      return m.kickoffMillis is int
          && request.time.toMillis() < m.kickoffMillis - 30 * 60 * 1000;
    }

    match /users/{userId} {
      allow read:   if isAuth();
      allow create: if isOwner(userId);
      allow update: if isOwner(userId) || isAdmin();
      allow delete: if isAdmin();
    }

    match /matches/{matchId} {
      allow read:  if isAuth();
      allow write: if isAdmin();
    }

    match /predictions/{predId} {
      // resource == null cubre el caso de documento inexistente (primera apuesta del usuario en ese partido)
      // Las predicciones ajenas solo se pueden leer cuando el partido ya arrancó (apuestas cerradas)
      allow read: if isAuth() && (
        resource == null ||
        resource.data.userId == request.auth.uid ||
        isAdmin() ||
        matchStarted(resource.data.matchId)
      );

      // El admin puede cargar la predicción de cualquiera (backfill por problemas en la app)
      allow create: if isAdmin() || (
           isAuth()
        && request.resource.data.userId == request.auth.uid
        && predId == request.auth.uid + '_' + string(request.resource.data.matchId)
        && request.resource.data.predictedHome >= 0
        && request.resource.data.predictedAway >= 0
        && request.resource.data.calculated == false
        && beforeCutoff(request.resource.data.matchId)   // 🔒 no se puede apostar pasado el cierre
      );

      // Editar solo antes del cierre (y si no fue calculada). El admin puede corregir siempre.
      allow update: if isAdmin() || (
           isAuth()
        && resource.data.userId == request.auth.uid
        && !resource.data.calculated
        && beforeCutoff(resource.data.matchId)           // 🔒 no se puede editar pasado el cierre
      );

      allow delete: if isAdmin();
    }

    match /standings/{docId} {
      allow read:  if isAuth();
      allow write: if isAdmin();
    }

    match /leagues/{leagueId} {
      // Lectura pública: hace falta validar el código de invitación durante el registro,
      // cuando el usuario todavía NO está autenticado. Solo expone nombre/código/conteo.
      allow read:   if true;
      // Solo admin puede crear ligas
      allow create: if isAdmin();
      // Admin edita todo; un usuario autenticado solo puede tocar memberCount (al unirse/salir)
      allow update: if isAdmin()
                    || (isAuth() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberCount']));
      allow delete: if isAdmin();
    }
  }
}
