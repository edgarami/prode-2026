rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuth()  { return request.auth != null; }
    function isOwner(uid) { return request.auth.uid == uid; }
    function isAdmin() {
      return isAuth() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    match /users/{userId} {
      allow read:   if isAuth();
      allow create: if isOwner(userId);
      allow update: if isOwner(userId) || isAdmin();
      allow delete: if isAdmin();
    }

    match /matches/{matchId} {
      allow read:  if isAuth();
      allow write: if isAdmin();
    }

    match /predictions/{predId} {
      // resource == null cubre el caso de documento inexistente (primera apuesta del usuario en ese partido)
      allow read: if isAuth() && (resource == null || resource.data.userId == request.auth.uid || isAdmin());

      allow create: if isAuth()
        && request.resource.data.userId == request.auth.uid
        && predId == request.auth.uid + '_' + string(request.resource.data.matchId)
        && request.resource.data.predictedHome >= 0
        && request.resource.data.predictedAway >= 0
        && request.resource.data.calculated == false;

      allow update: if (isAuth() && resource.data.userId == request.auth.uid && !resource.data.calculated)
                    || isAdmin();

      allow delete: if isAdmin();
    }

    match /standings/{docId} {
      allow read:  if isAuth();
      allow write: if isAdmin();
    }

    match /leagues/{leagueId} {
      // Cualquier usuario autenticado puede leer (para validar código de invitación)
      allow read:   if isAuth();
      // Solo admin puede crear/editar ligas
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }
  }
}
